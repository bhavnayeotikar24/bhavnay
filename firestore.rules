rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // 0. Global Safety Net & Helpers
    // ===============================================================
    
    // Default deny for everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper: Is the user signed in?
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Is the document ID valid (Prevents ID Poisoning)
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Sugar for data
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Role helpers - explicitly look up role from the source of truth (admins collection)
    // Note: Use get() to bypass rules and check the actual document data.
    function getAdminData() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function isApproved() {
      let data = getAdminData();
      return data.status == 'Approved';
    }

    function isSuperAdmin() {
      return isSignedIn() && getAdminData().role == 'super-admin';
    }

    function isAdmin() {
      return isSignedIn() && getAdminData().role == 'admin';
    }

    // Permanent Admin Guard
    function isPermanentAdmin(email) {
      return email in [
        'bhavnayeotikar@gmail.com', 
        'byeotikar@ergonavgroup.com', 
        'nfotopoulos@ergonavgroup.com'
      ];
    }

    // ===============================================================
    // 1. Admins Collection (RBAC Master)
    // ===============================================================

    match /admins/{uid} {
      // Schema Validation
      function isValidAdmin(data) {
        return data.keys().hasAll(['uid', 'adminId', 'email', 'role', 'isActive', 'status', 'createdAt'])
          && data.keys().size() <= 12 // Strictly bound the number of fields
          && data.uid == uid
          && data.role in ['super-admin', 'admin', 'analyst', 'quality-manager']
          && data.status in ['Pending Approval', 'Approved', 'Rejected']
          && data.isActive is bool
          && data.email is string && data.email.size() <= 100;
      }

      // Everyone signed in can see admin profiles (required for identity in the UI)
      allow get: if isSignedIn();
      
      // Only Admins and Super Admins can list the full administrators table
      allow list: if isSignedIn() && (isSuperAdmin() || isAdmin());
      
      // Create rules
      allow create: if (
        isSignedIn() && isValidId(uid) && isValidAdmin(incoming()) && (
          // System Super Admins are auto-approved if they have the right email
          (isPermanentAdmin(incoming().email) && incoming().role == 'super-admin' && incoming().status == 'Approved') ||
          // Ordinary signup starts as Pending
          (incoming().status == 'Pending Approval')
        )
      );

      // Update rules
      allow update: if (
        isSignedIn() && isValidId(uid) && isValidAdmin(incoming()) && (
          // Case 1: Updating one's own profile
          (request.auth.uid == uid && (
            // If they are a permanent admin, they CANNOT change their role, status, or email
            (!isPermanentAdmin(existing().email) || (
              incoming().role == existing().role && 
              incoming().status == existing().status && 
              incoming().email == existing().email
            ))
          )) ||
          // Case 2: Admins managing other users
          (!isPermanentAdmin(existing().email) && (
            isSuperAdmin() ||
            (isAdmin() && existing().role != 'super-admin' && incoming().role != 'super-admin')
          ))
        )
      );

      // Delete rules
      allow delete: if (
        isSignedIn() && isValidId(uid) && (
          // Cannot delete permanent admins
          !isPermanentAdmin(existing().email) && (
            isSuperAdmin() ||
            // Admins can delete any non-super-admin account
            (isAdmin() && existing().role != 'super-admin')
          )
        )
      );
    }

    // ===============================================================
    // 2. Reports Collection
    // ===============================================================

    match /reports/{reportId} {
      function isValidReport(data) {
        return data.keys().hasAll(['reportId', 'reportType', 'clientInfo', 'sampleInfo', 'testResults', 'analysisInfo', 'createdAt', 'createdBy'])
          && data.reportId == reportId
          && data.reportType in ['Biological', 'Biocide', 'Potable Water']
          && data.testResults is list
          && data.testResults.size() <= 50; // Bound list size
      }

      // All approved system users can read reports
      allow read: if isSignedIn() && isApproved();
      
      allow create: if (
        isSignedIn() && isApproved() && isValidId(reportId) && isValidReport(incoming())
        && incoming().createdBy == request.auth.uid // Must stamp with own ID
      );

      allow update: if (
        isSignedIn() && isApproved() && isValidId(reportId) && isValidReport(incoming()) && (
          isSuperAdmin() || 
          isAdmin() || 
          // Analysts/QM can only edit their own reports
          existing().createdBy == request.auth.uid
        )
      );

      allow delete: if (
        isSignedIn() && isApproved() && (isSuperAdmin() || isAdmin())
      );
    }

    // ===============================================================
    // 3. Audit Logs (Append-Only)
    // ===============================================================

    match /auditLogs/{logId} {
      function isValidLog(data) {
        return data.keys().hasAll(['id', 'userId', 'userEmail', 'timestamp', 'action', 'module'])
          && data.id == logId
          && data.userId == request.auth.uid; // Must match log to session user
      }

      // Only Admins can view audit logs
      allow read: if isSignedIn() && isApproved() && (isSuperAdmin() || isAdmin());
      
      // Everyone can create logs (to track their own actions)
      allow create: if (
        isSignedIn() && isValidId(logId) && isValidLog(incoming())
      );

      // Audit logs are tamper-proof (no updates or deletes)
      allow update, delete: if false;
    }
  }
}
